local isSelecting = false
local isAllSelected = false
local isCopying = false
local isCrashing = false
local selectedParts = {}

local function updateLabel()
    local count = 0
    local lastPartName = ""

    for part in pairs(selectedParts) do
        count = count + 1
        lastPartName = part.Name
    end

    if count == 1 then
        PartNameLabel.Text = "Part: " .. lastPartName
    elseif count > 1 then
        PartNameLabel.Text = "Part: Selected (" .. tostring(count) .. ")"
    else
        PartNameLabel.Text = "Part: None"
    end
end

local function getBTools()
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    local btools = (character and character:FindFirstChild("Building Tools")) or (backpack and backpack:FindFirstChild("Building Tools"))
    if btools and btools:FindFirstChild("SyncAPI") and btools.SyncAPI:FindFirstChild("ServerEndpoint") then
        return btools
    end
    PartNameLabel.Text = "Please equip 'Building Tools'"
    task.spawn(function()
        task.wait(2)
        updateLabel()
    end)
    return nil
end

