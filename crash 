        if part and part:IsDescendantOf(workspace) then
            table.insert(originalParts, part)
        end
    end

    if #originalParts == 0 then
        PartNameLabel.Text = "No Part Selected!"
        task.delay(2, updateLabel)
        return
    end

    isCopying = true
    CopyButton.Text = "Cancel"
    CopyButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50) 

    local currentAmount = 0
    AmountBox.Text = "0/" .. targetAmount

    task.spawn(function()
        while currentAmount < targetAmount and isCopying do
            local step = math.min(copyBatchSize, targetAmount - currentAmount)
            local newClones = {}

            local connection = workspace.DescendantAdded:Connect(function(descendant)
                if descendant:IsA("BasePart") then
                    for _, orig in ipairs(originalParts) do
                        if descendant.Name == orig.Name and descendant.Size == orig.Size then
                            table.insert(newClones, descendant)
                            break
                        end
                    end
                end
            end)

            for i = 1, step do
                ServerEndpoint:InvokeServer("Clone", originalParts, workspace)
            end

            task.wait(0.25)
            connection:Disconnect()

            for _, newPart in ipairs(newClones) do
                if not selectedParts[newPart] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "SelectionOutline"
                    highlight.Adornee = newPart
                    highlight.FillTransparency = 1
                    highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
                    highlight.OutlineTransparency = 0
                    highlight.Parent = newPart
                    selectedParts[newPart] = { Highlight = highlight }
                end
            end

            currentAmount = currentAmount + step
            AmountBox.Text = currentAmount .. "/" .. targetAmount
            updateLabel()
        end

        isCopying = false
        CopyButton.Text = "Copy & Select"
        CopyButton.BackgroundColor3 = Color3.fromRGB(150, 50, 200)
        AmountBox.Text = tostring(targetAmount)
    end)
