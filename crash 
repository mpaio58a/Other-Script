                end
            end
        end
    else
        SelectAllButton.Text = "All"
        SelectAllButton.BackgroundColor3 = Color3.fromRGB(255, 140, 0)

        for part, data in pairs(selectedParts) do
            if data.Highlight then data.Highlight:Destroy() end
        end
        table.clear(selectedParts)
    end
    updateLabel()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not isSelecting then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = mouse.Target
        if target and target:IsA("BasePart") then
            if selectedParts[target] then
                if selectedParts[target].Highlight then selectedParts[target].Highlight:Destroy() end
                selectedParts[target] = nil
            else
                local highlight = Instance.new("Highlight")
                highlight.Name = "SelectionOutline"
                highlight.Adornee = target
                highlight.FillTransparency = 1
                highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
                highlight.OutlineTransparency = 0
                highlight.Parent = target
                selectedParts[target] = { Highlight = highlight }
            end
            updateLabel()
        end
    end
end)

-- ระบบ Crash Mesh แบบใหม่
CrashButton.MouseButton1Click:Connect(function()
    if wasLongPressCrash then return end -- ป้องกันการทำงานหากผู้ใช้แค่กดค้างเพื่อเลือก Mesh ID

    local btools = getBTools()
    if not btools then return end

    if isCrashing then
        isCrashing = false
        return
    end

    local partsToModify = {}
    for part in pairs(selectedParts) do
        if part and part:IsDescendantOf(workspace) then
            table.insert(partsToModify, part)
        end
    end

    if #partsToModify == 0 then
        PartNameLabel.Text = "No Part Selected!"
        task.delay(2, updateLabel)
        return
    end

    local targetAmountText = CrashAmountBox.Text
    local targetAmount = tonumber(targetAmountText) or 0

    isCrashing = true
    CrashButton.Text = "Cancel"
    CrashButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)

    task.spawn(function()
        local ServerEndpoint = btools.SyncAPI.ServerEndpoint

        -- 1. เปลี่ยน Material เป็น ForceField และเปลี่ยนสีเป็น Cyan
        local matArgs = {}
        local colorArgs = {}
        for _, part in ipairs(partsToModify) do
            table.insert(matArgs, { Part = part, Material = Enum.Material.ForceField })
            table.insert(colorArgs, { Part = part, UnionColoring = true, Color = Color3.new(0, 1, 1) })
        end
        
        if isCrashing then
            ServerEndpoint:InvokeServer("SyncMaterial", matArgs)
            ServerEndpoint:InvokeServer("SyncColor", colorArgs)
            task.wait(0.1)
        end

        -- 2. ใส่ Crash Mesh
        if isCrashing then
            local createArgs = {}
            local syncArgs = {}
            for _, part in ipairs(partsToModify) do
                table.insert(createArgs, { Part = part })
                table.insert(syncArgs, {
                    Part = part,
                    MeshType = Enum.MeshType.FileMesh,
                    MeshId = "rbxassetid://" .. selectedMeshId,
                    Scale = Vector3.new(1000000, 1000000, 1000000)
                })
            end
            ServerEndpoint:InvokeServer("CreateMeshes", createArgs)
            ServerEndpoint:InvokeServer("SyncMesh", syncArgs)
            task.wait(0.15)
        end

        -- 3. ตรวจสอบว่าจำนวนคัดลอกมากกว่า 0 หรือไม่ หากใช่ ให้เข้าลูปโคลน
        if isCrashing and targetAmount > 0 then
            local currentAmount = 0
            CrashAmountBox.Text = "0/" .. targetAmount

            while currentAmount < targetAmount and isCrashing do
                local step = math.min(copyBatchSize, targetAmount - currentAmount)
                local newClones = {}

                local connection = workspace.DescendantAdded:Connect(function(descendant)
                    if descendant:IsA("BasePart") then
                        for _, orig in ipairs(partsToModify) do
                            if descendant.Name == orig.Name and descendant.Size == orig.Size then
                                table.insert(newClones, descendant)
                                break
                            end
                        end
                    end
                end)

                for i = 1, step do
                    if not isCrashing then break end
                    ServerEndpoint:InvokeServer("Clone", partsToModify, workspace)
                end

                task.wait(0.25)
                connection:Disconnect()

                for _, newPart in ipairs(newClones) do
                    if not selectedParts[newPart] then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "SelectionOutline"
                        highlight.Adornee = newPart
                        highlight.FillTransparency = 1
                        highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
                        highlight.OutlineTransparency = 0
                        highlight.Parent = newPart
                        selectedParts[newPart] = { Highlight = highlight }
                    end
                end

                currentAmount = currentAmount + step
                CrashAmountBox.Text = currentAmount .. "/" .. targetAmount
                updateLabel()
            end
        end

        -- รีเซ็ตสถานะกลับสู่ปกติเมื่อทำเสร็จ หรือถูกยกเลิก
        isCrashing = false
        CrashButton.Text = "Crash Mesh"
        CrashButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        CrashAmountBox.Text = tostring(targetAmount)
    end)
end)

