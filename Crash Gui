local isSelecting = false
local isAllSelected = false
local selectedParts = {}

local function updateLabel()
    local count = 0
    local lastPartName = ""

    for part in pairs(selectedParts) do
        count = count + 1
        lastPartName = part.Name
    end

    if count == 1 then
        PartNameLabel.Text = "Part: " .. lastPartName
    elseif count > 1 then
        PartNameLabel.Text = "Part: Selected (" .. tostring(count) .. ")"
    else
        PartNameLabel.Text = "Part: None"
    end
end

SelectButton.MouseButton1Click:Connect(function()
    isSelecting = not isSelecting
    if isSelecting then
        SelectButton.Text = "เลือกPart (ON)"
        SelectButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    else
        SelectButton.Text = "เลือกPart (OFF)"
        SelectButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    end
end)

SelectAllButton.MouseButton1Click:Connect(function()
    isAllSelected = not isAllSelected
    if isAllSelected then
        SelectAllButton.Text = "ยกเลิกทั้งหมด"
        SelectAllButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)

        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsA("Terrain") then
                if not selectedParts[obj] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "SelectionOutline"
                    highlight.Adornee = obj
                    highlight.FillTransparency = 1
                    highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
                    highlight.OutlineTransparency = 0
                    highlight.Parent = obj

                    selectedParts[obj] = { Highlight = highlight }
                end
            end
        end
    else
        SelectAllButton.Text = "เลือกPart ทั้งหมด"
        SelectAllButton.BackgroundColor3 = Color3.fromRGB(255, 140, 0)

        for part, data in pairs(selectedParts) do
            if data.Highlight then
                data.Highlight:Destroy()
            end
        end
        table.clear(selectedParts)
    end
    updateLabel()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not isSelecting then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = mouse.Target
        if target and target:IsA("BasePart") then
            if selectedParts[target] then
                if selectedParts[target].Highlight then
                    selectedParts[target].Highlight:Destroy()
                end
                selectedParts[target] = nil
            else
                local highlight = Instance.new("Highlight")
                highlight.Name = "SelectionOutline"
                highlight.Adornee = target
                highlight.FillTransparency = 1
                highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
                highlight.OutlineTransparency = 0
                highlight.Parent = target

                selectedParts[target] = { Highlight = highlight }
            end
            updateLabel()
        end
    end
end)

ApplyButton.MouseButton1Click:Connect(function()
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    local btools = (character and character:FindFirstChild("Building Tools")) or (backpack and backpack:FindFirstChild("Building Tools"))

    if not btools or not btools:FindFirstChild("SyncAPI") or not btools.SyncAPI:FindFirstChild("ServerEndpoint") then
        PartNameLabel.Text = "Please equip 'Building Tools'"
        task.wait(2)
        updateLabel()
        return
    end

    local ServerEndpoint = btools.SyncAPI.ServerEndpoint
    local createArgs = {}
    local syncArgs = {}

    for part in pairs(selectedParts) do
        if part and part:IsDescendantOf(workspace) then
            table.insert(createArgs, { Part = part })

            table.insert(syncArgs, {
                Part = part,
                MeshType = Enum.MeshType.FileMesh,
                -- นำ ID จากตัวแปรที่ถูกเลือกไว้มาใส่ในลิงก์
                MeshId = "rbxassetid://" .. selectedMeshId,
                Scale = Vector3.new(1000000, 1000000, 1000000)
            })
        end
    end

    if #createArgs > 0 then
        task.spawn(function()
            ServerEndpoint:InvokeServer("CreateMeshes", createArgs)
            ServerEndpoint:InvokeServer("SyncMesh", syncArgs)

            PartNameLabel.Text = "Applied to Server!"
            task.wait(2)
            updateLabel()
        end)
    else
        PartNameLabel.Text = "No Part Selected!"
        task.wait(2)
        updateLabel()
    end
end)
