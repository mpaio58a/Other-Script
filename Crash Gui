UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not isSelecting then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = mouse.Target
        if target and target:IsA("BasePart") then
            if selectedParts[target] then
                if selectedParts[target].Highlight then
                    selectedParts[target].Highlight:Destroy()
                end
                selectedParts[target] = nil
            else
                local highlight = Instance.new("Highlight")
                highlight.Name = "SelectionOutline"
                highlight.Adornee = target
                highlight.FillTransparency = 1
                highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
                highlight.OutlineTransparency = 0
                highlight.Parent = target

                selectedParts[target] = { Highlight = highlight }
            end
            updateLabel()
        end
    end
end)

CopyButton.MouseButton1Click:Connect(function()
    local btools = getBTools()
    if not btools then return end

    local targetAmount = tonumber(AmountBox.Text) or 1
    if targetAmount <= 0 then return end

    local ServerEndpoint = btools.SyncAPI.ServerEndpoint
    local originalParts = {}

    for part in pairs(selectedParts) do
        if part and part:IsDescendantOf(workspace) then
            table.insert(originalParts, part)
        end
    end

    if #originalParts == 0 then
        PartNameLabel.Text = "No Part Selected!"
        task.delay(2, updateLabel)
        return
    end

    CopyButton.Text = "Copying..."
    AmountBox.Text = "0/" .. targetAmount

    for i = 1, targetAmount do
        local newClones = {}

        -- ดักจับชิ้นส่วนที่ถูกสร้างขึ้นมาใหม่ในเซิร์ฟเวอร์
        local connection = workspace.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BasePart") then
                -- ตรวจสอบว่าเป็นพาร์ทที่ถูกโคลนมาจริงๆ (เช็คจากชื่อและขนาด) เพื่อกันไปโดนพาร์ทของคนอื่น
                for _, orig in ipairs(originalParts) do
                    if descendant.Name == orig.Name and descendant.Size == orig.Size then
                        table.insert(newClones, descendant)
                        break
                    end
                end
            end
        end)

        -- ส่งคำสั่ง Clone
        ServerEndpoint:InvokeServer("Clone", originalParts, workspace)

        -- รอเวลาให้เซิร์ฟเวอร์ทำการโคลนและโหลดลง Client ให้เสร็จ (ปรับเวลาได้ถ้าเน็ตช้า)
        task.wait(0.25)
        connection:Disconnect() -- ปิดการดักจับ

        -- นำชิ้นส่วนใหม่มาใส่ Highlight และเพิ่มเข้าไปใน List ที่เลือกไว้
        for _, newPart in ipairs(newClones) do
            if not selectedParts[newPart] then
                local highlight = Instance.new("Highlight")
                highlight.Name = "SelectionOutline"
                highlight.Adornee = newPart
                highlight.FillTransparency = 1
                highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
                highlight.OutlineTransparency = 0
                highlight.Parent = newPart

                selectedParts[newPart] = { Highlight = highlight }
            end
        end

        AmountBox.Text = i .. "/" .. targetAmount
    end

    CopyButton.Text = "Copy & Select"
    AmountBox.Text = tostring(targetAmount)
    updateLabel()
end)

UnanchorButton.MouseButton1Click:Connect(function()
    local btools = getBTools()
    if not btools then return end

    local ServerEndpoint = btools.SyncAPI.ServerEndpoint
    local syncArgs = {}

    for part in pairs(selectedParts) do
        if part and part:IsDescendantOf(workspace) then
            table.insert(syncArgs, {
                Part = part,
                Anchored = false
            })
        end
    end

    if #syncArgs > 0 then
        ServerEndpoint:InvokeServer("SyncAnchor", syncArgs)
        PartNameLabel.Text = "Unanchored " .. #syncArgs .. " parts!"
        task.delay(2, updateLabel)
    end
end)

ApplyButton.MouseButton1Click:Connect(function()
    local btools = getBTools()
    if not btools then return end

    isApplying = not isApplying

    if isApplying then
        ApplyButton.Text = "Apply : ON"
        ApplyButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)

        local partsToModify = {}
        for part in pairs(selectedParts) do
            if part and part:IsDescendantOf(workspace) then
                table.insert(partsToModify, part)
            end
        end

        if #partsToModify == 0 then
            isApplying = false
            ApplyButton.Text = "Apply : OFF"
            ApplyButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            PartNameLabel.Text = "No Part Selected!"
            task.wait(2)
            updateLabel()
            return
        end

        task.spawn(function()
            local ServerEndpoint = btools.SyncAPI.ServerEndpoint

            while isApplying do
                local createArgs = {}
                local syncArgs = {}

                for _, part in ipairs(partsToModify) do
                    table.insert(createArgs, { Part = part })
                    table.insert(syncArgs, {
                        Part = part,
                        MeshType = Enum.MeshType.FileMesh,
                        MeshId = "rbxassetid://" .. selectedMeshId,
                        Scale = Vector3.new(1000000, 1000000, 1000000)
                    })
                end

                ServerEndpoint:InvokeServer("CreateMeshes", createArgs)
                ServerEndpoint:InvokeServer("SyncMesh", syncArgs)

                task.wait(0.15)
            end
        end)
    else
        ApplyButton.Text = "Apply : OFF"
        ApplyButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
    end
end)