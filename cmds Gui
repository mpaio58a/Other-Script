local bypassCounter = 0

local function sendChatMessage(msg)
    if msg == "" then return end
    
    bypassCounter = (bypassCounter % 5) + 1
    local spaces = string.rep(" ", bypassCounter)
    local fullMessage = "/e :" .. msg .. spaces

    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral") or TextChatService.ChatInputBarConfiguration.TargetTextChannel
            if channel then
                channel:SendAsync(fullMessage)
            end
        else
            local sayEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if sayEvent then
                sayEvent:FireServer(fullMessage, "All")
            end
        end
    end)
end

ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

RunButton.MouseButton1Click:Connect(function()
    sendChatMessage(IdInput.Text)
end)

local isAuto = false
local currentDelay = 1
local autoThread = nil

DelayInput.FocusLost:Connect(function()
    local num = tonumber(DelayInput.Text)
    if num then
        currentDelay = math.max(0.1, num)
    else
        DelayInput.Text = tostring(currentDelay)
    end
    DelayInput.Visible = false
end)

local function toggleAuto()
    isAuto = not isAuto
    if isAuto then
        AutoButton.Text = "On"
        AutoButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        
        autoThread = task.spawn(function()
            while isAuto do
                local textToSend = IdInput.Text
                if textToSend ~= "" then
                    task.spawn(sendChatMessage, textToSend)
                end
                task.wait(currentDelay)
            end
        end)
    else
        AutoButton.Text = "Off"
        AutoButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        if autoThread then
            task.cancel(autoThread)
            autoThread = nil
        end
    end
end

local isHolding = false
local holdTick = 0

AutoButton.MouseButton1Down:Connect(function()
    isHolding = true
    holdTick = tick()
    
    task.spawn(function()
        task.wait(0.5)
        if isHolding then
            DelayInput.Visible = true
            DelayInput:CaptureFocus()
        end
    end)
end)

AutoButton.MouseButton1Up:Connect(function()
    if not isHolding then return end
    isHolding = false
    
    if tick() - holdTick < 0.5 and not DelayInput.Visible then
        toggleAuto()
    end
end)

AutoButton.MouseLeave:Connect(function()
    isHolding = false
end)
