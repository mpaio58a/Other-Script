-- Create Saved Item Function
local function addSavedItem(name, cmdStr)
    local Item = Instance.new("Frame")
    Item.Size = UDim2.new(1, -5, 0, 35)
    Item.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Item.Parent = ListScroll
    Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 6)

    local ItemName = Instance.new("TextLabel")
    ItemName.Size = UDim2.new(0.4, 0, 1, 0)
    ItemName.Position = UDim2.new(0, 5, 0, 0)
    ItemName.BackgroundTransparency = 1
    ItemName.Text = name
    ItemName.TextColor3 = Color3.fromRGB(255, 255, 255)
    ItemName.Font = Enum.Font.Gotham
    ItemName.TextSize = 12
    ItemName.TextXAlignment = Enum.TextXAlignment.Left
    ItemName.TextTruncate = Enum.TextTruncate.AtEnd
    ItemName.Parent = Item

    local ItemRun = Instance.new("TextButton")
    ItemRun.Size = UDim2.new(0.25, 0, 0.8, 0)
    ItemRun.Position = UDim2.new(0.42, 0, 0.1, 0)
    ItemRun.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
    ItemRun.Text = "Run"
    ItemRun.TextColor3 = Color3.fromRGB(255, 255, 255)
    ItemRun.Font = Enum.Font.GothamBold
    ItemRun.TextSize = 12
    ItemRun.Parent = Item
    Instance.new("UICorner", ItemRun).CornerRadius = UDim.new(0, 4)

    local ItemAuto = Instance.new("TextButton")
    ItemAuto.Size = UDim2.new(0.18, 0, 0.8, 0)
    ItemAuto.Position = UDim2.new(0.69, 0, 0.1, 0)
    ItemAuto.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    ItemAuto.Text = "Off"
    ItemAuto.TextColor3 = Color3.fromRGB(255, 255, 255)
    ItemAuto.Font = Enum.Font.GothamBold
    ItemAuto.TextSize = 12
    ItemAuto.Parent = Item
    Instance.new("UICorner", ItemAuto).CornerRadius = UDim.new(0, 4)

    local ItemDelete = Instance.new("TextButton")
    ItemDelete.Size = UDim2.new(0.08, 0, 0.8, 0)
    ItemDelete.Position = UDim2.new(0.89, 0, 0.1, 0)
    ItemDelete.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ItemDelete.Text = "🗑️"
    ItemDelete.TextSize = 10
    ItemDelete.Parent = Item
    Instance.new("UICorner", ItemDelete).CornerRadius = UDim.new(0, 4)

    -- Item Logic
    ItemRun.MouseButton1Click:Connect(function()
        sendChatMessage(cmdStr)
    end)

    local itemIsAuto = false
    local itemAutoThread = nil
    local currentDelay = tonumber(DelayInput.Text) or 1

    local function toggleItemAuto()
        itemIsAuto = not itemIsAuto
        if itemIsAuto then
            ItemAuto.Text = "On"
            ItemAuto.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            
            currentDelay = tonumber(DelayInput.Text) or 1 

            itemAutoThread = task.spawn(function()
                while itemIsAuto do
                    sendChatMessage(cmdStr)
                    task.wait(currentDelay)
                end
            end)
        else
            ItemAuto.Text = "Off"
            ItemAuto.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            if itemAutoThread then
                task.cancel(itemAutoThread)
                itemAutoThread = nil
            end
        end
    end

    local itemIsHolding = false
    local itemHoldTick = 0

    ItemAuto.MouseButton1Down:Connect(function()
        itemIsHolding = true
        itemHoldTick = tick()

        task.spawn(function()
            task.wait(0.5)
            if itemIsHolding then
                DelayInput.Visible = true
                DelayInput:CaptureFocus()
            end
        end)
    end)

    ItemAuto.MouseButton1Up:Connect(function()
        if not itemIsHolding then return end
        itemIsHolding = false

        if tick() - itemHoldTick < 0.5 and not DelayInput.Visible then
            toggleItemAuto()
        end
    end)

    ItemAuto.MouseLeave:Connect(function()
        itemIsHolding = false
    end)

    ItemDelete.MouseButton1Click:Connect(function()
        if itemAutoThread then task.cancel(itemAutoThread) end
        Item:Destroy()
        ListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    end)

    ListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 45)
end

